{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "613b2a29b3f448a294ffac4ba244131a",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CalcOcclusion (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -605.0000610351563,
            "y": 180.99998474121095,
            "width": 235.00006103515626,
            "height": 141.99998474121095
        }
    },
    "m_Slots": [
        {
            "m_Id": "c1b165b11b6d4967a8a7334b0b313e5c"
        },
        {
            "m_Id": "a5ac33b28e3b4d54a6ac33ec44e4950c"
        },
        {
            "m_Id": "a15be9987382458a83bfe38d71c2f8a6"
        },
        {
            "m_Id": "328c67dc3c0b42639b4a4e89926cbabe"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CalcOcclusion",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 1. Получаем глубину сцены\r\nfloat linearSceneDepth = LinearEyeDepth(sceneDepth, _ZBufferParams);\r\n\r\n// 2. Получаем глубину стены\r\nfloat wallDepth = abs(viewZ);\r\n\r\n// 3. ГЛАВНОЕ ИСПРАВЛЕНИЕ: Искусственно отодвигаем глубину стены на 0.25 метра (25 см)\r\n// Это создает \"мертвую зону\" перед стеной, где шейдер гарантированно считает объект находящимся СПЕРЕДИ.\r\nfloat safeWallDepth = wallDepth + 5;\r\n\r\n// 4. Считаем разницу с учетом защиты\r\nfloat diff = linearSceneDepth - safeWallDepth;\r\n\r\n// 5. Логика:\r\n// Если diff <= 0, объект точно перед стеной (или в \"мертвой зоне\" перед ней).\r\nif (diff <= 0.0) {\r\n    fade = 1.0; // Стена полностью видна\r\n} \r\nelse {\r\n    // Объект за стеной. Применяем плавное исчезновение.\r\n    fade = 1.0 - smoothstep(0.0, threshold, diff);\r\n}"
}

